def solve(arr,tar):
  n = len(arr)
  dp = [[False for _ in range(tar+1)]for _ in range(n+1)]
  for i in range(n+1):
    dp[i][0] = True
  for i in range(1, n+1):
    for j in range(1, tar+1):
      curr_num = arr[i-1]
      no_take = dp[i-1][j]
      if curr_num <= j:
        take = dp[i-1][j-curr_num]
      else:
        take = False
      dp[i][j] = no_take or  take
  return dp[n][tar]
arr = [2,3,7,8,10]
tar = 11
print(solve(arr,tar))
  
