class Solution:
    def knapsack(self, W: int, val: list[int], wt: list[int]) -> int:
        # code here
        n = len(val)
        dp = [[0 for _ in range(W+1)]for _ in range(n+1)]
        for i in range(1, n+1):
            for j in range(1, W+1):
                item_val = val[i-1]
                item_weight = wt[i-1]
                if item_weight <= j:
                    not_take = dp[i-1][j]
                    take = item_val + dp[i-1][j-item_weight]
                    dp[i][j] = max(not_take, take)
                else:
                    dp[i][j] = dp[i-1][j]
        return dp[n][W]
