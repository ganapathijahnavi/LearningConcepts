def find_anagrams(txt, pat):
    res = []
    n, m = len(txt), len(pat)
    if m > n:
        return res
      
    def check(substring, pattern):
        return sorted(substring) == sorted(pattern)

    for left in range(n - m + 1):
        window = txt[left : left + m]
        if window[0] == pat[0] or pat[0] in window: 
            if check(window, pat):
                res.append(left)
                
    return res
