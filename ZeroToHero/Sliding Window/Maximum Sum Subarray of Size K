# nums = [2,1,5,1,3,2]
k = 3
nums = [1,2,3]
#o/p 9
max_sum = 0
curr_sum = 0
for i in range(k):
    curr_sum += nums[i]
max_sum = curr_sum
l = 0
for j in range(k, len(nums)):
    curr_sum -= nums[l]
    l += 1
    curr_sum += nums[j]
    max_sum = max(max_sum, curr_sum)
print(max_sum)
    





















