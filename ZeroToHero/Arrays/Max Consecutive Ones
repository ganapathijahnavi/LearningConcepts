class Solution:
    def findMaxConsecutiveOnes(self, nums: List[int]) -> int:
        cnt = 1 if nums[0] == 1 else 0
        max_cnt = cnt
        if not nums:
            return 0
        for i in range(1, len(nums)):
            if nums[i] == 1:
                if nums[i] == nums[i-1]:
                    cnt += 1
                else:
                    cnt = 1
                max_cnt = max(max_cnt, cnt)
            else:
                cnt = 0
        return max_cnt
                
         

            
        
