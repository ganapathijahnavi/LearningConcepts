1. Get all HR employees
SELECT * FROM workers
WHERE department = 'HR';
2. Find workers older than 25
SELECT * FROM workers
WHERE age > 25;
3. Show names only
SELECT name FROM workers;
4. Sort by age descending
SELECT * FROM workers
ORDER BY age DESC;
5. Find salary between 50k–70k
SELECT * FROM workers
WHERE salary BETWEEN 50000 AND 70000;
6. Find names starting with G
SELECT * FROM workers
WHERE name LIKE 'G%';
7. Update HR salaries +5000
UPDATE workers
SET salary = salary + 5000
WHERE department = 'HR';
8. Delete employees below age 20
DELETE FROM workers
WHERE age < 20;
9. Find top 3 highest salaries
SELECT salary
FROM workers
ORDER BY salary DESC
LIMIT 3;
10. Count employees in IT
SELECT COUNT(id)
FROM workers
WHERE department = 'IT';
11. Find 2nd highest salary
select max(salary) from workers where salary < (select max(salary) from workers);
or
SELECT salary
FROM workers
ORDER BY salary DESC
LIMIT 1 OFFSET 1;
12. Find duplicate salaries
SELECT salary, COUNT(*)
FROM workers
GROUP BY salary
HAVING COUNT(*) > 1;
13. Update lowest salary employee
UPDATE workers
SET salary = salary + 5000
WHERE salary = (
    SELECT MIN(salary)
    FROM workers
);
14. Delete employees with NULL department
DELETE FROM workers
WHERE department IS NULL;
15. Find employees not in HR
SELECT * FROM workers
WHERE department NOT IN ('HR');

Aggregate + Group by
1. Count employees in each department
SELECT department, COUNT(*)
FROM workers
GROUP BY department;
2. Find average salary
SELECT AVG(salary)
FROM workers;
3. Find highest age
SELECT MAX(age)
FROM workers;
4. Find total salary in HR
SELECT SUM(salary)
FROM workers
WHERE department = 'HR';
or
SELECT department, SUM(salary)
FROM workers
GROUP BY department
HAVING department = 'HR';
5. Count distinct departments
SELECT DISTINCT department
FROM workers;
6. Find department with highest avg salary
SELECT department, AVG(salary) AS avg_salary
FROM workers
GROUP BY department
ORDER BY avg_salary DESC
LIMIT 1;
7. Find duplicate ages
SELECT age, COUNT(*)
FROM workers
GROUP BY age
HAVING COUNT(*) > 1;
8. Find departments having more than 2 employees
SELECT department, COUNT(*)
FROM workers
GROUP BY department
HAVING COUNT(*) > 2;
9. Find lowest salary per department
SELECT MIN(salary), department
FROM workers
GROUP BY department;
10. Find average age department-wise
SELECT AVG(age), department
FROM workers
GROUP BY department;
11. Find 2nd highest salary department-wise
SELECT department, salary
FROM (
    SELECT department,
           salary,
           DENSE_RANK() OVER (
               PARTITION BY department
               ORDER BY salary DESC
           ) AS rnk
    FROM workers
) t
WHERE rnk = 2;
12. Find departments where total salary > 100000
SELECT department,
       SUM(salary)
FROM workers
GROUP BY department
HAVING SUM(salary) > 100000;
13. Find employees earning above department average
SELECT name,
       salary,
       department
FROM workers w
WHERE salary > (
    SELECT AVG(salary)
    FROM workers
    WHERE department = w.department
);
14. Find departments with no duplicate salaries
SELECT department
FROM workers
GROUP BY department
HAVING COUNT(salary) = COUNT(DISTINCT salary);
15. Find top-paying department
SELECT department,
       SUM(salary) AS total_salary
FROM workers
GROUP BY department
ORDER BY total_salary DESC
LIMIT 1;



